events { worker_connections 1024; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  upstream spring-api {
    server ${SPRING_ALB_DNS}:8080;
    keepalive 32;
  }
  upstream websocket-server { server ${WEBSOCKET_HOST}:8080; }

  server {
    listen 80 default_server;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    location /ws {
        proxy_pass http://websocket-server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    location ^~ /api/sse {
        proxy_pass http://websocket-server;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        add_header X-Accel-Buffering no;
        chunked_transfer_encoding on;
    }

    location ^~ /api/notifications { proxy_pass http://websocket-server; }
    location ^~ /api/conversations { proxy_pass http://websocket-server; }
    location ^~ /api/direct-messages { proxy_pass http://websocket-server; }

    location ^~ /api/watching-sessions/sse {
        proxy_pass http://websocket-server;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        add_header X-Accel-Buffering no;
        chunked_transfer_encoding on;
    }

    location ~ ^/api/contents/[^/]+/watching-sessions {
        proxy_pass http://websocket-server;
    }

    location ~ ^/api/users/[^/]+/watching-sessions {
        proxy_pass http://websocket-server;
    }

    location /oauth2 {
        proxy_pass http://spring-api;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_connect_timeout 3s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /login {
        proxy_pass http://spring-api;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_connect_timeout 3s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api {
        proxy_pass http://spring-api;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_connect_timeout 3s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /actuator/core/ {
        proxy_pass http://spring-api/actuator/;
    }

    location /actuator/ws/ {
        proxy_pass http://websocket-server/actuator/;
    }
  }
}
